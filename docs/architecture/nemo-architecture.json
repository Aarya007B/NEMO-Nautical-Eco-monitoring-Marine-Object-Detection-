  "cards": [
    {
      "dot": "cyan",
      "title": "INPUT - Side-Scan Sonar",
      "items": [
        "Recorded sonar images and mission frames as raw input",
        "Mission metadata (timestamps, navigation, ping info) when available",
        "Native 1-channel grayscale preprocessing with letterbox resize to 640x640"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI PROCESSING - Two-Stage Detection",
      "items": [
        "YOLO11n-1C performs Stage 1 candidate detection with bounding boxes and class prediction",
        "Candidate Crop Extraction applies configured bbox padding and resizes to 128x128",
        "MobileNetV3-Small verifies each candidate as accept/reject with secondary verification score"
      ]
    },
    {
      "dot": "amber",
      "title": "MISSION INTELLIGENCE - Scoring to Export",
      "items": [
        "Confidence / Priority scoring fuses detector confidence and verifier artificial probability",
        "Metadata alignment uses timestamp nearest-neighbor matching for GPS coordinates",
        "Geolocation maps latitude/longitude; Reporting exports structured JSON and CSV records"
      ]
    },
    {
      "dot": "rose",
      "title": "APPLICATION - FastAPI and Dashboard",
      "items": [
        "FastAPI serves as the REST API layer with mission processing, detection, and export endpoints",
        "NEMO Dashboard provides mission upload, sonar visualization, detection inspection, map view, and report export",
        "Primary path: MISSION frames to YOLO11n-1C to MobileNetV3 to Scoring to Geolocation to Reporting to Dashboard; nav logs join at Metadata alignment"
      ]
    }
  ]
